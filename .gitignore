# 数据格式：.mat 备份与 .npy 均不跟踪（img/ 已整体排除，防御性冗余）
*.mat
*.npy
# 但 golden 数值基准必须入库（等价性闸门依赖）——豁免 tests/numerics/golden/
!tests/numerics/golden/
!tests/numerics/golden/*.npy

# hydra 运行输出目录
outputs/
.coverage
uv.lock

# mindfs 会话工具运行时 DB（不入 git）
.mindfs/

# COCO 人工候选审核图（临时产物；定稿图 coco_*_{big,hbs}.png 正常跟踪）
figures/hbsn/cand_*.png

# 噪声候选审核图与汇总（临时产物；终稿 f_noise_ab.png 正常跟踪）
figures/hbsn/candidates/

# Claude Code 运行时产物（hooks 生成，不入 git；.claude/memory + settings.json 保留）
# **/ 前缀：嵌套 .claude/（如 figures/hbsn/.claude/）同样忽略
**/.claude/accumulator.json
**/.claude/insights/
**/.claude/metrics/
**/.claude/observations/
**/.claude/sessions/
**/.claude/compact-state.json
